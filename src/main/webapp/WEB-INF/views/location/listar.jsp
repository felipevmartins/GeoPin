<%@ include file="../shared/header.jspf" %>
<div class="explore-heading"><div><p class="eyebrow">SEU MUNDO, EM COORDENADAS</p><h1>Um mapa. Seus lugares<span>.</span></h1><p>Explore pontos salvos ou descubra um novo destino.</p></div><a class="text-link" href="<c:url value='/location/novo'/>">+ Salvar um novo lugar</a></div>
<div id="map-workspace" class="map-workspace" data-api-key="<c:out value='${mapsApiKey}'/>" data-map-id="<c:out value='${mapsMapId}'/>">
<aside class="panel map-sidebar"><div class="panel-heading"><h2>Meus lugares</h2><span class="count-badge" id="place-count"></span></div><label class="sr-only" for="place-search">Buscar lugar por nome</label><input id="place-search" type="search" placeholder="Buscar um lugar…" autocomplete="off"><div class="place-list" id="saved-places"><c:forEach var="place" items="${listaLocations}"><button type="button" class="place-item" data-place-id="${place.id}" data-name="<c:out value='${place.name}'/>" data-lat="${place.latitude}" data-lng="${place.longitude}"><span class="place-icon" aria-hidden="true"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span><span><strong><c:out value="${place.name}"/></strong><small><c:out value="${place.latitude}"/> / <c:out value="${place.longitude}"/></small></span><span class="item-arrow" aria-hidden="true">↗</span></button></c:forEach></div><p id="search-empty" class="empty-state" hidden>Nenhum lugar encontrado.</p><c:if test="${empty listaLocations}"><div class="empty-state"><h3>Seu mapa começa aqui.</h3><p>Adicione um lugar ou explore usando coordenadas.</p><a href="<c:url value='/location/novo'/>">Adicionar lugar →</a></div></c:if>
<form id="plot-form" class="quick-plot"><h3>Explorar coordenadas</h3><div class="field-row"><div><label for="plot-lat">Latitude</label><input id="plot-lat" type="number" step="any" min="-90" max="90" required placeholder="-3.7447"></div><div><label for="plot-lng">Longitude</label><input id="plot-lng" type="number" step="any" min="-180" max="180" required placeholder="-38.5277"></div></div><button class="button button-full" type="submit">Localizar no mapa ↗</button><p class="field-hint">Uma prévia para explorar, sem salvar.</p></form></aside>
<section class="map-region" aria-label="Mapa de localizações"><div id="map_canvas" role="region" aria-label="Google Maps"></div><div id="map-message" class="map-message" role="status" aria-live="polite"><span class="map-message-icon" aria-hidden="true"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span><h2>Preparando seu mapa</h2><p>Conectando ao Google Maps…</p></div><div class="map-caption"><span class="live-dot"></span> GOOGLE MAPS <span>·</span> EXPLORE SEUS LUGARES</div></section>
</div><section id="place-details" class="panel place-details" hidden aria-live="polite"><div><p class="eyebrow">PONTO SELECIONADO</p><h2 id="detail-name"></h2><p id="detail-coordinates" class="muted"></p></div><div><p class="detail-label">TAGS DO LUGAR</p><div id="detail-tags" class="tag-list"></div><p id="detail-status" role="status"></p></div><a id="detail-google-link" class="text-link" target="_blank" rel="noopener noreferrer">Abrir no Google Maps ↗</a></section>
<script defer src="<c:url value='/scripts/mapa.js'/>"></script>
<%@ include file="../shared/footer.jspf" %>
