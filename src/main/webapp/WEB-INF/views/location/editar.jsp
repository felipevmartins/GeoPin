<%@ include file="../shared/header.jspf" %>
<div class="page-heading"><p class="eyebrow">GERENCIAR LUGARES</p><h1>Seus lugares, sempre em dia.</h1><p>Selecione um lugar para atualizar suas informações.</p></div>
<div class="manage-layout"><section class="panel"><div class="panel-heading"><h2>Lugares salvos</h2><a class="text-link" href="<c:url value='/location/deletar'/>">Excluir lugares</a></div><div class="place-list">
<c:forEach var="place" items="${listaLocations}"><button type="button" class="place-item" data-edit-location="${place.id}"><span class="place-icon" aria-hidden="true"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span><span><strong><c:out value="${place.name}"/></strong><small><c:out value="${place.latitude}"/> / <c:out value="${place.longitude}"/></small></span><span class="item-arrow" aria-hidden="true">↗</span></button></c:forEach>
<c:if test="${empty listaLocations}"><div class="empty-state"><h3>Ainda não há lugares por aqui.</h3><a href="<c:url value='/location/novo'/>">Adicione seu primeiro lugar →</a></div></c:if></div></section>
<section class="panel form-panel"><p id="selection-hint" class="muted">Escolha um lugar na lista para começar.</p><p id="form-status" role="status" aria-live="polite"></p><form id="location-management" data-mode="editar" method="post" hidden><input type="hidden" name="_method" value="PUT"><span class="panel-kicker">EDITAR LUGAR</span><label for="nome">Nome do lugar</label><input id="nome" name="name" required maxlength="255" placeholder="Ex.: Meu lugar favorito" autocomplete="off">
<div class="field-row"><div><label for="latitude">Latitude</label><input id="latitude" name="latitude" type="number" step="any" min="-90" max="90" required placeholder="-3.7447"></div><div><label for="longitude">Longitude</label><input id="longitude" name="longitude" type="number" step="any" min="-180" max="180" required placeholder="-38.5277"></div></div>
<p class="field-hint">Use graus decimais. Latitude entre −90 e 90; longitude entre −180 e 180.</p><button class="button " type="submit">Salvar alterações →</button></form></section></div>
<%@ include file="../shared/footer.jspf" %>
